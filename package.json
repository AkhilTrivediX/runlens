{
  "name": "runlens-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "RunLens is local-first observability for browser automation reliability.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:puppeteer": "tsx examples/puppeteer-basic/src/index.ts",
    "test:playwright": "tsx examples/playwright-basic/src/index.ts",
    "test:dashboard": "tsx scripts/dashboard-smoke.ts",
    "smoke": "tsx scripts/smoke.ts",
    "dev:dashboard": "pnpm --filter @runlens/core build && pnpm --filter @runlens/dashboard dev",
    "clean:traces": "tsx scripts/clean-traces.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
