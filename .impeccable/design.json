      "kind": "button",
      "refersTo": "button-follow",
      "description": "Toggle explicit polling of the local trace store.",
      "html": "<button class=\"ds-follow\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 0 1 15-6l3 3M21 3v6h-6M21 12a9 9 0 0 1-15 6l-3-3M3 21v-6h6\"/></svg>Follow runs</button>",
      "css": ".ds-follow{font-family:\"Segoe UI\",Helvetica,Arial,sans-serif;transition:background-color .18s ease,color .18s ease,border-color .18s ease;display:inline-flex;align-items:center;gap:8px;border:1px solid #cad4e0;border-radius:7px;background:var(--surface,#fff);color:#243549;font-size:13px;padding:9px 12px;cursor:pointer;}.ds-follow:hover{color:var(--accent,#255bd2);}.ds-follow:disabled{opacity:.55;cursor:wait;}.ds-follow:focus-visible{outline:3px solid #8aacf4;outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-follow{transition:none;}}"
    },
