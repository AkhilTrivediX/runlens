      "refersTo": "panel",
      "description": "Flat bordered white container for recorded runs and trace details.",
      "html": "<section class=\"ds-panel\"><header><h2>Execution trace</h2><span>6 steps</span></header><div class=\"ds-panel-body\">Select a step to inspect its evidence.</div></section>",
      "css": ".ds-panel{font-family:\"Segoe UI\",Helvetica,Arial,sans-serif;background:var(--surface,#fff);color:var(--ink,#203249);border:1px solid var(--line,#dce3ea);border-radius:var(--radius,14px);overflow:hidden;}.ds-panel header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px 18px;border-bottom:1px solid var(--line,#dce3ea);}.ds-panel h2{margin:0;font-size:13px;font-weight:650;}.ds-panel header span{font-size:11px;color:var(--muted,#526276);}.ds-panel-body{font-size:12px;color:var(--muted,#526276);padding:19px 22px 22px;}"
    },
    {
      "name": "Selected Run",
      "kind": "custom",
      "refersTo": "ledger-row-selected",
      "description": "Retain the run identity and timing while the inspector changes.",
      "html": "<button class=\"ds-ledger-row\" aria-pressed=\"true\"><div class=\"ds-run-name\"><strong>Checkout workflow</strong><span>commerce · chromium</span><div>Local run · 09:42</div></div><div class=\"ds-run-meta\"><span>Failed</span><span>6.42 s</span></div></button>",
      "css": ".ds-ledger-row{font-family:\"Segoe UI\",Helvetica,Arial,sans-serif;transition:background-color .18s ease,color .18s ease,border-color .18s ease;display:flex;align-items:flex-start;gap:10px;width:100%;padding:16px 16px 15px;text-align:left;border:0;border-bottom:1px solid #e8edf2;position:relative;min-height:95px;background:var(--accent-wash,#edf3ff);cursor:pointer;}.ds-ledger-row:after{content:\"\";position:absolute;right:0;top:0;bottom:0;width:1px;background:var(--accent,#255bd2);}.ds-ledger-row:hover{background:#f4f7fb;}.ds-run-name{flex:1;min-width:0;}.ds-run-name strong{display:block;font-size:13px;font-weight:600;color:var(--ink,#203249);line-height:1.45;overflow-wrap:anywhere;}.ds-run-name>span{display:block;font-size:11px;color:var(--muted,#526276);margin-top:4px;}.ds-run-name>div{font-size:10px;color:var(--muted,#526276);margin-top:10px;}.ds-run-meta{display:flex;flex-direction:column;gap:19px;align-items:flex-end;font-size:11px;color:var(--muted,#526276);font-variant-numeric:tabular-nums;}.ds-run-meta span:first-child{color:var(--fail,#b34a2a);font-weight:550;}.ds-ledger-row:focus-visible{outline:3px solid #8aacf4;outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-ledger-row{transition:none;}}"
    },
    {
      "name": "Execution Waterfall",
      "kind": "custom",
      "refersTo": "waterfall-row",
      "description": "Measured time lane with an event marker and selected step.",
      "html": "<button class=\"ds-waterfall-row\" aria-pressed=\"true\"><span class=\"ds-step-label\">03 Submit order</span><span class=\"ds-waterfall-track\"><span class=\"ds-waterfall-bar\"></span><i title=\"Recorded event\"></i></span><span class=\"ds-duration\">2.40 s</span></button>",
      "css": ".ds-waterfall-row{font-family:\"Segoe UI\",Helvetica,Arial,sans-serif;transition:background-color .18s ease,color .18s ease,border-color .18s ease;display:grid;grid-template-columns:minmax(155px,1fr) minmax(130px,1.25fr) 55px;gap:9px;align-items:center;width:100%;text-align:left;border:0;border-radius:5px;padding:10px 7px;min-height:42px;background:#fff0e5;cursor:pointer;}.ds-waterfall-row:hover{background:#f3f6fa;}.ds-step-label{font-size:11px;line-height:1.4;color:var(--ink,#203249);overflow-wrap:anywhere;}.ds-waterfall-track{display:block;position:relative;height:16px;background:#f0f3f7;border-radius:3px;overflow:hidden;}.ds-waterfall-bar{position:absolute;left:20%;width:60%;top:3px;bottom:3px;border-radius:2px;background:#cc7d5a;min-width:2px;}.ds-waterfall-track i{position:absolute;left:72%;top:5px;bottom:5px;width:1px;background:#243b52;opacity:.6;}.ds-duration{font-family:\"Cascadia Code\",Consolas,monospace;font-size:10px;color:var(--muted,#526276);text-align:right;white-space:nowrap;}.ds-waterfall-row:focus-visible{outline:3px solid #8aacf4;outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-waterfall-row{transition:none;}}@media(max-width:420px){.ds-waterfall-row{grid-template-columns:1fr 42px;}.ds-waterfall-track{grid-column:1/-1;grid-row:2;margin:7px 0;}}"
    }
  ],
  "narrative": {
    "northStar": "The Investigation Instrument",
    "overview": "RunLens uses the visual language of a measured browser run investigation instrument. Deep blue navigation anchors a pale steel workspace. Compact white surfaces hold runs, timing and evidence with clear boundaries. The atmosphere is calm and technical.\n\nSelection connects the run ledger to the execution waterfall and its evidence. Blue identifies actions and selected context. Green and copper report recorded outcomes. Density supports investigation without making every datum compete for attention.\n\nThe identity uses an authored geometric vector mark and existing library icons. Product decoration contains no generated imagery. Screenshots belong to captured browser evidence and retain their real source.",
    "keyCharacteristics": [
      "Deep blue navigation and a pale steel workspace.",
      "Compact ledgers with a wider inspector.",
      "Measured timing lanes and linked evidence.",
      "Restrained colour with explicit status labels.",
      "Familiar interface type paired with precise code and timing type."
    ],
    "rules": [
      {
        "name": "The Recorded State Rule",
        "body": "Use green and copper for recorded outcomes. Preserve status text or an accessible icon label alongside colour.",
        "section": "colors"
      },
      {
        "name": "The Evidence Type Rule",
        "body": "Keep IDs, selectors, payloads and measured durations in the implemented monospace stack. Allow long technical values to wrap.",
        "section": "typography"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "Keep ledger, inspector and reliability panels flat. Use borders and tonal selection to establish context.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use blue to make selected context and available actions clear.",
      "Do keep outcome colour tied to recorded status with visible or accessible labels.",
      "Do retain measured waterfall timing and the connection between steps and evidence.",
      "Do wrap long technical values and preserve the implemented type families.",
      "Do use flat white panels with quiet borders on the steel workspace.",
      "Do honour visible focus and reduced motion behaviour."
    ],
    "donts": [
      "Don't add decorative shadows to the main investigation panels.",
      "Don't replace recorded artifacts with decorative or generated imagery.",
      "Don't use outcome colour without a status label or accessible icon label.",
      "Don't make supporting text paler than the final muted token.",
      "Don't separate step evidence from the selected execution context."
    ]
  }
}
