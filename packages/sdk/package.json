{
  "name": "runlens",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Lightweight observability SDK for browser automation reliability.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkhilTrivediX/runlens.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "playwright",
    "puppeteer",
    "browser-automation",
    "observability",
    "tracing",
    "sqlite",
    "debugging"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/puppeteer": {
      "types": "./dist/adapters/puppeteer.d.ts",
      "default": "./dist/adapters/puppeteer.js"
    },
    "./adapters/playwright": {
      "types": "./dist/adapters/playwright.d.ts",
      "default": "./dist/adapters/playwright.js"
    }
  },
  "bin": {
    "runlens": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@runlens/core": "workspace:*"
  }
}
