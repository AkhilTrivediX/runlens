{
  "name": "runlens",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Lightweight observability SDK for browser automation reliability.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkhilTrivediX/runlens.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "playwright",
    "puppeteer",
    "browser-automation",
    "observability",
    "tracing",
    "sqlite",
    "debugging"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/puppeteer": {
      "types": "./dist/adapters/puppeteer.d.ts",
      "default": "./dist/adapters/puppeteer.js"
    },
    "./adapters/playwright": {
      "types": "./dist/adapters/playwright.d.ts",
      "default": "./dist/adapters/playwright.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "default": "./dist/dashboard.js"
    }
  },
  "bin": {
    "runlens": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/vendor-core.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prepack": "pnpm --filter @runlens/core build && pnpm run build && pnpm --filter @runlens/dashboard build && node ../../scripts/prepare-package.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "author": {
    "name": "Akhil Trivedi",
    "email": "akhiltrivedix@gmail.com"
  },
  "devDependencies": {
    "@runlens/core": "workspace:*"
  }
}
